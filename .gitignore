.venv*/
__pycache__/
*.py[cod]
.pytest_cache/
third_party/
weights/
cache/
data/raw/
data/downloads/
outputs/

# Downloadable or regenerated research assets stay outside ordinary Git.
*.pth
*.pt
*.ckpt
*.npy
*.npz
*.zip
!artifacts/evidence/execution_evidence_20261010.zip

# Local credentials and LaTeX build intermediates.
.ssh/
.env
.env.*
auth.json
*.pem
*.key
paper/*.aux
paper/*.log
paper/*.out
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz

# V2 append-only local experiments; small public evidence has a separate directory.
outputs_v2/
!artifacts/v2/**/*.zip
paper/revisions/**/*.aux
paper/revisions/**/*.log
paper/revisions/**/*.out
paper/revisions/**/*.fls
paper/revisions/**/*.fdb_latexmk
paper/revisions/**/*.synctex.gz

# V3 append-only local scientific evidence.
outputs_v3/
!artifacts/v3/**/*.zip
paper/revisions/v3_*/**/*.aux
paper/revisions/v3_*/**/*.log
paper/revisions/v3_*/**/*.out
# Oversized first G2 public ZIP retained locally; exact byte chunks backed up separately.
artifacts/v3/g2/evidence.zip
